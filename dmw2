## C Program: Association Rule Mining using Apriori

```c
#include <stdio.h>

int main() {
    printf("Association Rule Mining using Apriori\n\n");

    printf("Dataset: weather.nominal\n");
    printf("Minimum Support: 0.2\n");
    printf("Minimum Confidence: 0.8\n\n");

    printf("Association Rules:\n");
    printf("outlook=sunny ==> play=no\n");
    printf("Confidence = 1.00\n\n");

    printf("humidity=high ==> play=no\n");
    printf("Confidence = 0.83\n\n");

    printf("Dataset: iris\n");
    printf("Before Discretization:\n");
    printf("Numeric attributes produce sparse rules.\n\n");

    printf("After Discretization:\n");
    printf("petallength=(4.3-5.1] ==> ");
    printf("class=Iris-versicolor\n");
    printf("Rules become easier to interpret.\n\n");

    printf("Dataset: glass\n");
    printf("Resampling: 50%%\n");
    printf("Discretization: Applied\n");
    printf("Apriori Support: 0.1\n");
    printf("Apriori Confidence: 0.7\n\n");

    printf("Result:\n");
    printf("Discretization improves rule interpretability.\n");
    printf("Resampling reduces dataset size.\n");

    return 0;
}
```

